<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the macrdp Camera CoreMediaIO system extension
  (camera redirection Phase 3). Used by packaging/make-camera-extension.sh when it
  signs the extension executable + bundle.

  A system extension MUST be sandboxed. The App Group is what lets CMIO's
  CMIOExtensionMachServiceName resolve (the service name in camera-Info.plist must
  be prefixed by one of these groups), and is shared with the container controller
  app (see macrdp-controller.entitlements). The camera device entitlement matches
  Apple's camera-extension samples.

  The App Group id (__APP_GROUP__, substituted by the packaging script, e.g.
  QGLA89KHM7.com.clintcan.macrdp) MUST be registered in the Apple Developer portal
  and included in this extension's provisioning profile, or codesign / activation
  fails. VERIFY the exact required set against the CMIO-packaging research before
  first activation (whether the camera device entitlement is required for a
  sink-fed virtual camera, and whether the container app must also list the group).
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>__APP_GROUP__</string>
    </array>
</dict>
</plist>
